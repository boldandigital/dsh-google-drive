{
  "name": "dsh-google-drive",
  "version": "0.1.0",
  "description": "Add Google Drive accounts to the DeepSeek Harness from the sidebar: sign in with OAuth, or paste a service-account key, then browse the account's Drive files.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "google-drive",
    "google",
    "oauth",
    "service-account"
  ],
  "license": "MIT",
  "author": "boldandigital",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "assets/icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.0"
  }
}
