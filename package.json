{
  "name": "dsh-google-drive",
  "version": "0.1.8",
  "description": "Connect Google Drive accounts in the DeepSeek Harness Settings, then browse the account's files in the right sidebar and drag a file straight into the conversation.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "google-drive",
    "google",
    "oauth",
    "service-account"
  ],
  "license": "MIT",
  "author": {
    "name": "boldandigital",
    "url": "https://github.com/boldandigital"
  },
  "homepage": "https://github.com/boldandigital/dsh-google-drive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boldandigital/dsh-google-drive.git"
  },
  "bugs": {
    "url": "https://github.com/boldandigital/dsh-google-drive/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "docs",
    "assets/icon.svg",
    "assets/icon-180.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node test/run.mjs"
  }
}
